<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Loyercam.Pages.QuittancesPage"
    Title="Quittances"
    BackgroundColor="#F5F7FB">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Quittances de loyer"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#172554" />
            <Label Text="Retrouvez les paiements enregistrés."
                   FontSize="14"
                   TextColor="#64748B" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Padding="16"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="6">
                <Label Text="TOTAL DES PAIEMENTS AFFICHÉS"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#64748B" />
                <Label x:Name="TotalPaiementsLabel"
                       Text="0 FCFA"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#15803D" />
                <Label x:Name="NombrePaiementsLabel"
                       Text="0 paiement"
                       FontSize="13"
                       TextColor="#64748B" />
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <SearchBar x:Name="RechercheEntry"
                       Placeholder="Rechercher un locataire ou une période"
                       TextChanged="RechercheEntry_TextChanged"
                       BackgroundColor="White" />

            <Button x:Name="ActualiserButton"
                    Text="Actualiser l'historique"
                    Clicked="ActualiserButton_Clicked"
                    BackgroundColor="#1D4ED8"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="46" />

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#64748B" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        x:Name="ListeQuittances"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     Spacing="8"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="Aucun paiement trouvé"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Les paiements enregistrés apparaîtront ici."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="9">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding NomLocataire}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#172554" />

                                <Label Grid.Column="1"
                                       Text="{Binding MontantTexte}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#15803D" />
                            </Grid>

                            <Label Text="{Binding NomLogement}"
                                   FontSize="13"
                                   TextColor="#64748B" />

                            <BoxView HeightRequest="1"
                                     Color="#E2E8F0" />

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="10">

                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="Période du loyer"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding Periode}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="Date du paiement"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding DatePaiementTexte}"
                                           FontSize="14"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="Mode de paiement"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding ModePaiement}"
                                           FontSize="14"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="Référence"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding ReferenceTexte}"
                                           FontSize="14"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                            </Grid>

                            <Border Padding="10"
                                    BackgroundColor="#F0FDF4"
                                    Stroke="#BBF7D0"
                                    StrokeShape="RoundRectangle 8">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="Reste à payer sur ce loyer"
                                           FontSize="13"
                                           TextColor="#166534"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding ResteDuTexte}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#166534"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Boutons de génération et de partage PDF -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Button Grid.Column="0"
                                        Text="Enregistrer PDF"
                                        FontSize="12"
                                        Padding="6"
                                        BackgroundColor="#1D4ED8"
                                        TextColor="White"
                                        CornerRadius="8"
                                        CommandParameter="{Binding .}"
                                        Clicked="EnregistrerPdfButton_Clicked" />

                                <Button Grid.Column="1"
                                        Text="Partager PDF"
                                        FontSize="12"
                                        Padding="6"
                                        BackgroundColor="#15803D"
                                        TextColor="White"
                                        CornerRadius="8"
                                        CommandParameter="{Binding .}"
                                        Clicked="PartagerPdfButton_Clicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
