<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Loyercam.Pages.AccueilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Accueil"
    BackgroundColor="#F3F6FC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="22">

            <!-- En-tête -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <VerticalStackLayout Spacing="4"
                                     VerticalOptions="Center">

                    <Label
                        Text="BIENVENUE SUR"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#64748B"
                        CharacterSpacing="1.5" />

                    <Label
                        Text="LoyerCam"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#123B70" />

                    <Label
                        Text="Votre gestion locative simplifiée."
                        FontSize="13"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="54"
                    HeightRequest="54"
                    BackgroundColor="#DBEAFE"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 17"
                    VerticalOptions="Center">

                    <Label
                        Text="🏠"
                        FontSize="27"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Carte principale -->
            <Border
                BackgroundColor="#123B70"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="TABLEAU DE BORD"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#BFDBFE"
                                CharacterSpacing="1.3" />

                            <Label
                                Text="Votre patrimoine,&#10;en un coup d'œil."
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="White" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#28558C"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13"
                            Padding="11"
                            VerticalOptions="Start">

                            <Label
                                Text="📊"
                                FontSize="24"
                                VerticalOptions="Center"
                                HorizontalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#42638B" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">

                        <Label
                            Text="📅"
                            FontSize="15"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="DateLabel"
                            Grid.Column="1"
                            FontSize="13"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>

                    <Label
                        Text="Suivez vos logements, vos locataires et vos paiements depuis un seul espace."
                        FontSize="13"
                        TextColor="#DBEAFE"
                        LineHeight="1.3" />

                </VerticalStackLayout>
            </Border>

            <!-- Statistiques -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Vue d'ensemble"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#172B4D" />

                <Label
                    Text="Les chiffres de votre gestion locative"
                    FontSize="13"
                    TextColor="#64748B" />
            </VerticalStackLayout>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <!-- Logements -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 17"
                    Padding="15">

                    <VerticalStackLayout Spacing="12">

                        <Border
                            BackgroundColor="#DBEAFE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="43"
                            HeightRequest="43"
                            HorizontalOptions="Start">

                            <Label
                                Text="🏠"
                                FontSize="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Logements"
                            FontSize="13"
                            TextColor="#64748B" />

                        <Label
                            x:Name="LogementsLabel"
                            Text="0"
                            FontSize="29"
                            FontAttributes="Bold"
                            TextColor="#2563EB" />

                        <Label
                            Text="Biens enregistrés"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>
                </Border>

                <!-- Locataires -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 17"
                    Padding="15">

                    <VerticalStackLayout Spacing="12">

                        <Border
                            BackgroundColor="#CCFBF1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="43"
                            HeightRequest="43"
                            HorizontalOptions="Start">

                            <Label
                                Text="👥"
                                FontSize="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Locataires"
                            FontSize="13"
                            TextColor="#64748B" />

                        <Label
                            x:Name="LocatairesLabel"
                            Text="0"
                            FontSize="29"
                            FontAttributes="Bold"
                            TextColor="#0F766E" />

                        <Label
                            Text="Locataires enregistrés"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>
                </Border>

                <!-- Encaissements -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 17"
                    Padding="15">

                    <VerticalStackLayout Spacing="12">

                        <Border
                            BackgroundColor="#DCFCE7"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="43"
                            HeightRequest="43"
                            HorizontalOptions="Start">

                            <Label
                                Text="💰"
                                FontSize="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Total encaissé"
                            FontSize="13"
                            TextColor="#64748B" />

                        <Label
                            x:Name="EncaisséLabel"
                            Text="0 FCFA"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#15803D"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="Paiements enregistrés"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>
                </Border>

                <!-- Impayés -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 17"
                    Padding="15">

                    <VerticalStackLayout Spacing="12">

                        <Border
                            BackgroundColor="#FEE2E2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="43"
                            HeightRequest="43"
                            HorizontalOptions="Start">

                            <Label
                                Text="⚠️"
                                FontSize="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Reste à payer"
                            FontSize="13"
                            TextColor="#64748B" />

                        <Label
                            x:Name="ImpayesLabel"
                            Text="0 FCFA"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#DC2626"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="Soldes restant dus"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Navigation rapide -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Accès rapide"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#172B4D" />

                <Label
                    Text="Que souhaitez-vous gérer aujourd'hui ?"
                    FontSize="13"
                    TextColor="#64748B" />
            </VerticalStackLayout>

            <!-- Logements -->
            <Border
                BackgroundColor="#2563EB"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15"
                Padding="15">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Border
                        BackgroundColor="#477CF0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="46"
                        HeightRequest="46"
                        VerticalOptions="Center">

                        <Label
                            Text="🏠"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Gérer les logements"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Vos biens immobiliers"
                            FontSize="12"
                            TextColor="#DBEAFE" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Button
                        Grid.ColumnSpan="3"
                        Text=""
                        BackgroundColor="Transparent"
                        Opacity="0.01"
                        Clicked="LogementsButton_Clicked"
                        SemanticProperties.Description="Gérer les logements" />

                </Grid>
            </Border>

            <!-- Locataires -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="15">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Border
                        BackgroundColor="#CCFBF1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="46"
                        HeightRequest="46"
                        VerticalOptions="Center">

                        <Label
                            Text="👥"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Gérer les locataires"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Dossiers et informations"
                            FontSize="12"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        TextColor="#64748B"
                        VerticalOptions="Center" />

                    <Button
                        Grid.ColumnSpan="3"
                        Text=""
                        BackgroundColor="Transparent"
                        Opacity="0.01"
                        Clicked="LocatairesButton_Clicked"
                        SemanticProperties.Description="Gérer les locataires" />

                </Grid>
            </Border>

            <!-- Loyers -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="15">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Border
                        BackgroundColor="#DCFCE7"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="46"
                        HeightRequest="46"
                        VerticalOptions="Center">

                        <Label
                            Text="💰"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Consulter les loyers"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Suivi des paiements"
                            FontSize="12"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        TextColor="#64748B"
                        VerticalOptions="Center" />

                    <Button
                        Grid.ColumnSpan="3"
                        Text=""
                        BackgroundColor="Transparent"
                        Opacity="0.01"
                        Clicked="LoyersButton_Clicked"
                        SemanticProperties.Description="Consulter les loyers" />

                </Grid>
            </Border>

            <!-- Impayés -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="15">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Border
                        BackgroundColor="#FEE2E2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="46"
                        HeightRequest="46"
                        VerticalOptions="Center">

                        <Label
                            Text="⚠️"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Voir les impayés"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Montants restant dus"
                            FontSize="12"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        TextColor="#64748B"
                        VerticalOptions="Center" />

                    <Button
                        Grid.ColumnSpan="3"
                        Text=""
                        BackgroundColor="Transparent"
                        Opacity="0.01"
                        Clicked="ImpayesButton_Clicked"
                        SemanticProperties.Description="Voir les impayés" />

                </Grid>
            </Border>

            <!-- Quittances -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="15">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Border
                        BackgroundColor="#EDE9FE"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="46"
                        HeightRequest="46"
                        VerticalOptions="Center">

                        <Label
                            Text="📄"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Consulter les quittances"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Historique et documents PDF"
                            FontSize="12"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        TextColor="#64748B"
                        VerticalOptions="Center" />

                    <Button
                        Grid.ColumnSpan="3"
                        Text=""
                        BackgroundColor="Transparent"
                        Opacity="0.01"
                        Clicked="QuittancesButton_Clicked"
                        SemanticProperties.Description="Consulter les quittances" />

                </Grid>
            </Border>

            <!-- Actualisation -->
            <Button
                Text="↻   Actualiser les chiffres"
                Clicked="ActualiserButton_Clicked"
                BackgroundColor="#DBEAFE"
                TextColor="#1D4ED8"
                FontAttributes="Bold"
                CornerRadius="13"
                HeightRequest="50" />

            <Label
                x:Name="MessageLabel"
                Text=""
                FontSize="12"
                TextColor="#64748B"
                HorizontalTextAlignment="Center" />

            <Label
                Text="LoyerCam • Gestion locative"
                FontSize="11"
                TextColor="#94A3B8"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
