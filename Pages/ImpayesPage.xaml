<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Loyercam.Pages.ImpayesPage"
    Title="Impayés"
    BackgroundColor="#F5F7FB">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Gestion des impayés"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#172554" />

            <Label Text="Suivi des loyers restant à payer"
                   FontSize="14"
                   TextColor="#64748B" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Padding="18"
                BackgroundColor="#FFFFFF"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 14">

            <VerticalStackLayout Spacing="6">
                <Label Text="TOTAL DES IMPAYÉS"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#64748B" />

                <Label x:Name="TotalImpayesLabel"
                       Text="0 FCFA"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#DC2626" />

                <Label x:Name="NombreImpayesLabel"
                       Text="0 loyer en retard"
                       FontSize="13"
                       TextColor="#64748B" />
            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="2"
                x:Name="ActualiserButton"
                Text="Actualiser les impayés"
                Clicked="ActualiserButton_Clicked"
                BackgroundColor="#1D4ED8"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="48" />

        <CollectionView Grid.Row="3"
                        x:Name="ListeImpayes"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     Spacing="10"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="Aucun impayé à afficher"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Les loyers échus et non réglés apparaîtront ici."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="{Binding NomLocataire}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#172554" />

                            <Label Text="{Binding NomLogement}"
                                   FontSize="13"
                                   TextColor="#64748B" />

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">

                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="0"
                                                     Spacing="2">
                                    <Label Text="Période"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding Periode}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="Échéance"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding EcheanceTexte}"
                                           FontSize="14"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="0"
                                                     Spacing="2">
                                    <Label Text="Loyer"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding MontantDuTexte}"
                                           FontSize="14"
                                           TextColor="#334155" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="Déjà payé"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding MontantPayeTexte}"
                                           FontSize="14"
                                           TextColor="#15803D" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#E2E8F0" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">

                                <Label Grid.Column="0"
                                       Text="Reste à payer"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#334155"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding ResteDuTexte}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#DC2626"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
