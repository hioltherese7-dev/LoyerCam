<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Loyercam.Pages.ImpayesPage"
    Title="Impayés"
    BackgroundColor="#F4F7FC">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="18">

        <!-- En-tête -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="5">

            <Label Text="Gestion des impayés"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#172B4D" />

            <Label Text="Suivez les loyers échus et les montants restant à payer."
                   FontSize="14"
                   TextColor="#718096" />

        </VerticalStackLayout>

        <!-- Résumé des impayés -->
        <Border Grid.Row="1"
                Padding="20"
                BackgroundColor="White"
                Stroke="#E1E8F2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18">

            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="5">

                        <Label Text="TOTAL RESTANT À ENCAISSER"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#718096" />

                        <Label x:Name="TotalImpayesLabel"
                               Text="0 FCFA"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#DC2626" />

                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            BackgroundColor="#FEF2F2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            VerticalOptions="Center">

                        <Label Text="!"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#DC2626"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />

                    </Border>

                </Grid>

                <BoxView HeightRequest="1"
                         Color="#E9EEF5" />

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">

                    <Label Grid.Column="0"
                           Text="●"
                           FontSize="12"
                           TextColor="#DC2626"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           x:Name="NombreImpayesLabel"
                           Text="0 loyer en retard"
                           FontSize="13"
                           TextColor="#64748B"
                           VerticalOptions="Center" />

                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Actualisation -->
        <Button Grid.Row="2"
                x:Name="ActualiserButton"
                Text="↻  Actualiser les impayés"
                Clicked="ActualiserButton_Clicked"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50"
                Padding="12,0" />

        <!-- Liste des loyers impayés -->
        <CollectionView Grid.Row="3"
                        x:Name="ListeImpayes"
                        SelectionMode="None"
                        ItemsLayout="VerticalList">

            <CollectionView.EmptyView>

                <VerticalStackLayout Padding="24"
                                     Spacing="12"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Border WidthRequest="68"
                            HeightRequest="68"
                            Padding="0"
                            BackgroundColor="#EAF1FF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            HorizontalOptions="Center">

                        <Label Text="✓"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="#2563EB"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />

                    </Border>

                    <Label Text="Aucun impayé à afficher"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172B4D"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Les loyers échus et non réglés apparaîtront ici."
                           FontSize="14"
                           TextColor="#718096"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           MaximumWidthRequest="280" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border Margin="0,0,0,14"
                            Padding="18"
                            BackgroundColor="White"
                            Stroke="#E1E8F2"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="14">

                            <!-- Locataire et logement -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="5">

                                    <Label Text="{Binding NomLocataire}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="#172B4D"
                                           LineBreakMode="WordWrap" />

                                    <Label Text="{Binding NomLogement}"
                                           FontSize="13"
                                           TextColor="#718096"
                                           LineBreakMode="WordWrap" />

                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        Padding="9,5"
                                        BackgroundColor="#FEF2F2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        VerticalOptions="Start">

                                    <Label Text="IMPAYÉ"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#DC2626" />

                                </Border>

                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#E9EEF5" />

                            <!-- Période et échéance -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="5">

                                    <Label Text="Période"
                                           FontSize="12"
                                           TextColor="#718096" />

                                    <Label Text="{Binding Periode}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#334155" />

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="5">

                                    <Label Text="Échéance"
                                           FontSize="12"
                                           TextColor="#718096" />

                                    <Label Text="{Binding EcheanceTexte}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#334155" />

                                </VerticalStackLayout>

                            </Grid>

                            <!-- Montants -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="5">

                                    <Label Text="Loyer prévu"
                                           FontSize="12"
                                           TextColor="#718096" />

                                    <Label Text="{Binding MontantDuTexte}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#334155" />

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="5">

                                    <Label Text="Déjà payé"
                                           FontSize="12"
                                           TextColor="#718096" />

                                    <Label Text="{Binding MontantPayeTexte}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#15803D" />

                                </VerticalStackLayout>

                            </Grid>

                            <!-- Solde restant -->
                            <Border Padding="13"
                                    BackgroundColor="#FFF5F5"
                                    Stroke="#FEE2E2"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="4"
                                                         VerticalOptions="Center">

                                        <Label Text="RESTE À PAYER"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#991B1B" />

                                        <Label Text="Montant non réglé"
                                               FontSize="12"
                                               TextColor="#9F6262" />

                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding ResteDuTexte}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="#DC2626"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="End" />

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
