<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Loyercam.Pages.LocatairesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Locataires"
    BackgroundColor="#F4F7FC">

    <ScrollView>
        <VerticalStackLayout Padding="20,22" Spacing="22">

            <!-- En-tête -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Mes locataires"
                    FontSize="29"
                    FontAttributes="Bold"
                    TextColor="#172B4D" />

                <Label
                    Text="Gérez les occupants de vos biens immobiliers."
                    FontSize="14"
                    TextColor="#718096" />
            </VerticalStackLayout>

            <!-- Formulaire d'enregistrement -->
            <Border
                Padding="18"
                BackgroundColor="White"
                Stroke="#E1E8F2"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Nouveau locataire"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Label
                                Text="Complétez les informations ci-dessous."
                                FontSize="12"
                                TextColor="#718096" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="10,8"
                            BackgroundColor="#EAF1FF"
                            StrokeThickness="0"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                                Text="♙"
                                FontSize="25"
                                TextColor="#2563EB"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#E8EDF5" />

                    <Label
                        Text="INFORMATIONS PERSONNELLES"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#718096" />

                    <Label
                        Text="Nom complet *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#344563" />

                    <Entry
                        x:Name="NomLocataireEntry"
                        Placeholder="Ex. Jean Dupont"
                        ClearButtonVisibility="WhileEditing"
                        BackgroundColor="#F7F9FC"
                        TextColor="#172B4D"
                        PlaceholderColor="#9AA6B6" />

                    <Label
                        Text="Téléphone *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#344563" />

                    <Entry
                        x:Name="TelephoneEntry"
                        Placeholder="Ex. 6XXXXXXXX"
                        Keyboard="Telephone"
                        ClearButtonVisibility="WhileEditing"
                        BackgroundColor="#F7F9FC"
                        TextColor="#172B4D"
                        PlaceholderColor="#9AA6B6" />

                    <Label
                        Text="Pièce d'identité"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#344563" />

                    <Entry
                        x:Name="PieceEntry"
                        Placeholder="Numéro de pièce (facultatif)"
                        ClearButtonVisibility="WhileEditing"
                        BackgroundColor="#F7F9FC"
                        TextColor="#172B4D"
                        PlaceholderColor="#9AA6B6" />

                    <Label
                        Text="Adresse e-mail"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#344563" />

                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Ex. jean@email.com (facultatif)"
                        Keyboard="Email"
                        ClearButtonVisibility="WhileEditing"
                        BackgroundColor="#F7F9FC"
                        TextColor="#172B4D"
                        PlaceholderColor="#9AA6B6" />

                    <BoxView
                        HeightRequest="1"
                        Margin="0,4"
                        Color="#E8EDF5" />

                    <Label
                        Text="INFORMATIONS DE LOCATION"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#718096" />

                    <Label
                        Text="Date de début de location"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#344563" />

                    <Border
                        Padding="8,4"
                        BackgroundColor="#F7F9FC"
                        Stroke="#E1E8F2"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <DatePicker
                            x:Name="DateDebutLocationPicker"
                            Format="dd/MM/yyyy"
                            TextColor="#172B4D" />
                    </Border>

                    <Label
                        Text="Logement occupé *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#344563" />

                    <Border
                        Padding="8,4"
                        BackgroundColor="#F7F9FC"
                        Stroke="#E1E8F2"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Picker
                            x:Name="LogementPicker"
                            Title="Choisir un logement"
                            ItemDisplayBinding="{Binding Nom}"
                            TextColor="#172B4D" />
                    </Border>

                    <Label
                        Text="Les champs marqués d'un * sont obligatoires."
                        FontSize="11"
                        TextColor="#718096" />

                    <Button
                        Text="＋  Enregistrer le locataire"
                        Clicked="AjouterLocataire_Clicked"
                        HeightRequest="52"
                        CornerRadius="12"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="MessageLocataireLabel"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="#16803D" />

                </VerticalStackLayout>
            </Border>

            <!-- Liste -->
            <VerticalStackLayout Spacing="5">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">

                    <Label
                        Text="Locataires enregistrés"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#172B4D"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="1"
                        Padding="11,7"
                        BackgroundColor="#EAF1FF"
                        StrokeThickness="0"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="NombreLocatairesLabel"
                            Text="0 locataire"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#2563EB" />
                    </Border>
                </Grid>

                <Label
                    Text="Retrouvez les coordonnées et les informations de location."
                    FontSize="13"
                    TextColor="#718096" />
            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="ListeLocataires"
                Spacing="14">

                <Label
                    Text="Aucun locataire enregistré."
                    FontSize="14"
                    TextColor="#718096" />

            </VerticalStackLayout>

            <Label
                Text="LoyerCam • Gestion immobilière"
                FontSize="11"
                TextColor="#9AA6B6"
                HorizontalOptions="Center"
                Margin="0,4,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
